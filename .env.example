# NATURALDUB-AI Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# Base Database (SQLite by default, override for PostgreSQL)
DATABASE_URL=sqlite:///./naturaldub.db

# API Settings
PORT=8000
HOST=0.0.0.0

# LLM Config (Using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b  # Fallback model, replace with qwen3:30b if available

# Pyannote (For advanced diarization, if token provided)
HF_AUTH_TOKEN=your_huggingface_token_here
HF_TOKEN=your_huggingface_token_here

# Groq API Key (for Whisper ASR and LLM)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam API Key (for Hindi TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# ElevenLabs API Key for Voice Cloning
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenRouter API Key (optional LLM fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Enable/Disable modules
ENABLE_ADVANCED_MODELS=True
